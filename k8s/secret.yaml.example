apiVersion: v1
kind: Secret
metadata:
  name: marketing-microservice-secret
  namespace: statex-apps
  labels:
    app: marketing-microservice
    managed-by: k8s-migration
type: Opaque
stringData:
  # Set DB_PASSWORD from project .env (never commit k8s/secret.yaml).
  DB_PASSWORD: ""
  # Service token required for protected write/execution APIs.
  MARKETING_API_TOKEN: ""
  NOTIFICATION_SERVICE_TOKEN: ""
  JWT_TOKEN: ""
  ORDERS_SERVICE_TOKEN: ""
