{
  "name": "marketing-microservice",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing core service with campaign execution",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts"
  },
  "dependencies": {
    "axios": "latest",
    "dotenv": "latest",
    "express": "latest",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
